#!/bin/sh
# CGI that echoes stdin back with a delay to test timing issues
# Default safe behavior: stream stdin to stdout without creating files unless debug is enabled.
if [ -n "$WEBSERV_DEBUG_CGI" ]; then
	TMPFILE=$(mktemp /tmp/youpi_stdin.XXXXXX)
	cat > "$TMPFILE"
	sleep 1  # Add delay to ensure parent finishes writing
	L=$(wc -c < "$TMPFILE" | tr -d ' ')
	printf "Status: 200 OK\r\nContent-Type: text/plain\r\nContent-Length: %s\r\n\r\n" "$L"
	cat "$TMPFILE"
	rm -f "$TMPFILE"
	exit 0
else
	# In safe mode avoid disk writes; still attempt to emulate a small delay before output
	printf "Status: 200 OK\r\nContent-Type: text/plain\r\n\r\n"
	# optional small delay to simulate slow CGI
	sleep 1
	cat -
	exit 0
fi
