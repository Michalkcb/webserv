#!/bin/sh
# If `WEBSERV_DEBUG_CGI` is set, persist stdin to /tmp for local debugging.
# Otherwise avoid creating files during evaluation runs.
if [ -n "$WEBSERV_DEBUG_CGI" ]; then
	TMPFILE="/tmp/youpi_bla.$$"
	cp_stash="/tmp/youpi_stdin.$$"
	cat > "$TMPFILE"
	cp "$TMPFILE" "$cp_stash" 2>/dev/null || true
	echo "Content-Type: text/plain"
	echo "Content-Length: $(wc -c < "$TMPFILE")"
	echo ""
	cat "$TMPFILE"
else
	# Default safe behavior: stream input directly to stdout without creating files.
	echo "Content-Type: text/plain"
	echo ""
	cat -
fi
